<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android no permite reglas cleartext dinámicas por IP/host desde preferencias;
         el uso de HTTP queda controlado en código por confirmación explícita del usuario.
         HTTPS mantiene las CAs del sistema sin confiar en certificados arbitrarios. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
